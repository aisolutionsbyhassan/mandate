# required: the key agents (SDK, n8n, hooks) send in the x-mandate-key header
MANDATE_API_KEY=
# optional: enables AI explanations and plain-English rule drafting (fallback text is used without it)
GROQ_API_KEY=
# optional: create the first human account on boot (SQLite resets on every redeploy)
MANDATE_ADMIN_USER=
MANDATE_ADMIN_PASSWORD=
MANDATE_ADMIN_NAME=
# optional: a shared evaluator login, created on boot and shown on the sign-in page
MANDATE_DEMO_USER=
MANDATE_DEMO_PASSWORD=
MANDATE_DEMO_NAME=
# optional: require an invite code to create an account (default: signup is open)
MANDATE_REQUIRE_INVITE=
# optional: separate secret for signing session cookies (defaults to MANDATE_API_KEY)
MANDATE_SESSION_SECRET=
